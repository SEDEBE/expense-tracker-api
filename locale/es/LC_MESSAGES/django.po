#: apps/users/services.py:87
msgid "Reset your password"
msgstr "Restablece tu contraseña"

#: apps/users/services.py:89
#, python-format
msgid ""
"The link works for %(hours)d hours and only once. If you did not ask for it, "
"ignore this email: your password stays the same."
msgstr ""
"El enlace funciona durante %(hours)d horas y una sola vez. Si no lo has "
"pedido, ignora este correo: tu contraseña no cambia."

#: apps/users/services.py:97
msgid ""
"Someone asked to reset the password of your account. If it was you, open "
"this link to choose a new one:"
msgstr ""
"Alguien ha pedido restablecer la contraseña de tu cuenta. Si has sido tú, "
"abre este enlace para elegir una nueva:"

#: apps/users/services.py:107
msgid ""
"Someone asked to reset the password of your account. If it was you, choose a "
"new one with the button below."
msgstr ""
"Alguien ha pedido restablecer la contraseña de tu cuenta. Si has sido tú, "
"elige una nueva con el botón de abajo."

#: apps/users/services.py:119
msgid "Choose a new password"
msgstr "Elegir una contraseña nueva"

#: apps/users/services.py:121
msgid "If the button doesn't work, copy this link into your browser:"
msgstr "Si el botón no funciona, copia este enlace en el navegador:"

#: apps/users/services.py:128
msgid "This link is not valid or has expired. Ask for a new one."
msgstr "Este enlace no es válido o ha caducado. Pide uno nuevo."

#: apps/users/views.py:63
msgid "Signing in with Google is not available."
msgstr "El inicio de sesión con Google no está disponible."

#: apps/users/views.py:69
msgid "Google could not confirm your identity."
msgstr "Google no ha podido confirmar tu identidad."

#: apps/users/views.py:78
msgid "This account is disabled."
msgstr "Esta cuenta está desactivada."

#: apps/users/views.py:98
msgid ""
"If an account uses that email, we have sent it a link to reset the password."
msgstr ""
"Si hay una cuenta con ese email, le hemos enviado un enlace para restablecer "
"la contraseña."

