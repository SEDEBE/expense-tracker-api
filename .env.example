# Copy to .env and adjust. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres started by `docker compose up -d db`
POSTGRES_DB=expenses
POSTGRES_USER=expenses
POSTGRES_PASSWORD=expenses
DATABASE_URL=postgres://expenses:expenses@localhost:5432/expenses

# Sender for outgoing emails (optional)
DEFAULT_FROM_EMAIL=Expense Tracker <no-reply@localhost>

# Where emails go: consolemail:// prints them; smtp://localhost:1025 delivers to Mailpit
EMAIL_URL=consolemail://

# Redis started by `docker compose up -d redis`, used by Celery as the message broker
CELERY_BROKER_URL=redis://localhost:6379/0

# Frontend origins allowed by CORS (comma separated). 5173 is the Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173
